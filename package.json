{
  "name": "ata-mw",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dist": "npm run build && node scripts/check-manifests.mjs && tsc -p tsconfig.dist.json && node --disallow-code-generation-from-strings scripts/edge-smoke.mjs"
  },
  "devDependencies": {
    "@middy/core": "^7.9.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "ata-validator": "^1.42.0",
    "express": "^5.2.1",
    "express4": "npm:express@^4.22.3",
    "hono": "^4.13.13",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
