{
  "name": "@ata-mw/middy",
  "version": "0.1.2",
  "description": "Middy middleware that validates API Gateway requests and responses with ata-validator.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ata-mw/core": "^0.1.2"
  },
  "peerDependencies": {
    "@middy/core": ">=5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayhansipahi/ata-mw.git",
    "directory": "packages/middy"
  },
  "keywords": [
    "middy",
    "aws-lambda",
    "api-gateway",
    "ata-validator",
    "json-schema",
    "validation",
    "middleware"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ayhansipahi/ata-mw/tree/main/packages/middy#readme",
  "bugs": {
    "url": "https://github.com/ayhansipahi/ata-mw/issues"
  }
}
